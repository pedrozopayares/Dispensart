# Contexto software/ para la imagen de la API: lista blanca. Nunca secretos, dependencias ni la SPA.
*
!api
!docker/api
**/.env
**/.env.*
!**/.env.example
api/vendor
api/node_modules
api/tests
api/phpunit.xml
api/phpstan.neon
api/.phpunit.cache
api/storage/logs/*
api/storage/framework/cache/data/*
api/storage/framework/sessions/*
api/storage/framework/testing
api/storage/framework/views/*
api/bootstrap/cache/*.php
