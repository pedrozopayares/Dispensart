# Plantilla del stack de compose. Copiar a software/.env (ignorado por git) solo para cambiar valores.
# El stack arranca SIN este archivo: todos los valores de abajo son los predeterminados de desarrollo local.
# Repositorio público: nunca escribir aquí ni subir secretos reales.

# Puertos publicados al host (db solo en 127.0.0.1).
WEB_PORT=8090
DB_PORT=5434

# Base de datos. La contraseña es SOLO de desarrollo local; reemplazarla en cualquier otro entorno.
DB_DATABASE=dispensart
DB_USERNAME=dispensart
DB_PASSWORD=dispensart_local_dev_only

# API. APP_KEY vacía: el arranque genera una y la persiste en el volumen api_state.
# Definirla aquí (base64:...) hace que se use tal cual.
APP_KEY=
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=info
