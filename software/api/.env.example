# Plantilla de entorno de la API. Copiar a .env (ignorado por git); nunca subir valores reales.
APP_NAME=Dispensart
APP_ENV=local
# Vacía a propósito: se genera con `php artisan key:generate` (en contenedor la gestiona el arranque).
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Logs JSON por línea a stderr con correlation_id.
LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=dispensart
DB_USERNAME=dispensart
# Contraseña SOLO de desarrollo local (la misma de compose.yaml); reemplazar fuera de local.
DB_PASSWORD=dispensart_local_dev_only
DB_CONNECT_TIMEOUT=2

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@dispensart.test"
MAIL_FROM_NAME="${APP_NAME}"
