<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Arch">
            <directory>tests/Arch</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_KEY" value="" force="true"/>
        <env name="APP_LOCALE" value="es" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Catálogo de modelos del asistente (S15, design D3): caché vacía en cada prueba, nada compartido entre corridas. -->
        <env name="ASSISTANT_MODELS_CACHE_STORE" value="array" force="true"/>
        <!-- Siempre PostgreSQL y siempre la base de pruebas: nunca SQLite ni la base de desarrollo (design D3). -->
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="dispensart_test" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <!-- Laravel lee $_SERVER antes que $_ENV: el entorno del contenedor (compose) ganaría sin estas líneas. -->
        <server name="DB_CONNECTION" value="pgsql" force="true"/>
        <server name="DB_DATABASE" value="dispensart_test" force="true"/>
        <server name="DB_URL" value="" force="true"/>
        <!-- Asistente simulado y modelo por defecto sea cual sea el .env del anfitrión (S17, design D1): <server> gana
             en env()/config(), <env> en getenv() y en los procesos hijos. Una prueba que necesite Ollama lo fija ella misma. -->
        <env name="AI_PROVIDER" value="mock" force="true"/>
        <server name="AI_PROVIDER" value="mock" force="true"/>
        <env name="OLLAMA_MODEL" value="qwen2.5:3b" force="true"/>
        <server name="OLLAMA_MODEL" value="qwen2.5:3b" force="true"/>
        <!-- Las pruebas que leen el log redirigen el canal a un archivo temporal; el resto lo descarta. -->
        <env name="LOG_CHANNEL" value="stderr" force="true"/>
        <env name="LOG_STDERR_STREAM" value="php://memory" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!-- Siembra determinista: sin contraseña de entorno salvo que la prueba la fije (design D10). -->
        <env name="SEED_USER_PASSWORD" value="" force="true"/>
        <server name="SEED_USER_PASSWORD" value="" force="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
