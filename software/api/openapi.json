{
    "openapi": "3.1.0",
    "info": {
        "title": "Dispensart API",
        "version": "0.1.0",
        "description": "API de Dispensart: dispensaci\u00f3n de medicamentos, inventario por lote (FEFO) y traslados entre bodegas para FARTMAR IPS. Autenticaci\u00f3n Sanctum SPA por cookie HttpOnly con token CSRF (GET /sanctum/csrf-cookie y cabecera X-XSRF-TOKEN en toda escritura). Sin tokens bearer. Todo rechazo responde JSON {code, message[, errors]}; `code` es estable y `message` est\u00e1 en espa\u00f1ol.",
        "license": {
            "name": "MIT",
            "identifier": "MIT"
        }
    },
    "servers": [
        {
            "url": "/api",
            "description": "Mismo origen que la SPA."
        }
    ],
    "paths": {
        "/auth/login": {
            "post": {
                "operationId": "auth.login",
                "summary": "Inicia sesi\u00f3n por cookie HttpOnly. Nunca devuelve token",
                "tags": [
                    "Login"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LoginRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "`AuthenticatedUserResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/AuthenticatedUserResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Sin permiso para el rol, o login desde un origen ajeno a la SPA. code: forbidden",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    },
                    "419": {
                        "description": "Falta X-XSRF-TOKEN o no corresponde a la sesi\u00f3n. code: csrf_token_mismatch",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Datos inv\u00e1lidos (code: validation_failed, con errors) o credenciales inv\u00e1lidas (code: invalid_credentials).",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Demasiados intentos fallidos de login; ver Retry-After. code: too_many_attempts",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        },
                        "headers": {
                            "Retry-After": {
                                "description": "Segundos hasta poder reintentar.",
                                "required": true,
                                "schema": {
                                    "type": "integer"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {}
                ]
            }
        },
        "/auth/logout": {
            "post": {
                "operationId": "auth.logout",
                "summary": "Cierra la sesi\u00f3n actual",
