    "components": {
        "securitySchemes": {
            "sessionCookie": {
                "type": "apiKey",
                "description": "Cookie de sesi\u00f3n HttpOnly emitida por POST /auth/login.",
                "in": "cookie",
                "name": "dispensart-session"
            },
            "xsrfToken": {
                "type": "apiKey",
                "description": "Valor de la cookie XSRF-TOKEN (GET /sanctum/csrf-cookie). Obligatoria en escrituras.",
                "in": "header",
                "name": "X-XSRF-TOKEN"
            }
        },
        "schemas": {
            "ApiError": {
                "type": "object",
                "properties": {
                    "code": {
                        "type": "string",
                        "description": "C\u00f3digo estable del rechazo (contrato con la SPA).",
                        "enum": [
                            "unauthenticated",
                            "forbidden",
                            "not_found",
                            "csrf_token_mismatch",
                            "validation_failed",
                            "invalid_credentials",
                            "too_many_attempts",
                            "method_not_allowed",
                            "http_error",
                            "server_error"
                        ]
                    },
                    "message": {
                        "type": "string",
